# Never put real secrets in this example file.

# Public business configuration — leave blank until confirmed
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BUSINESS_EMAIL=

# MapTiler browser token; restrict it by domain in the provider dashboard
NEXT_PUBLIC_MAPTILER_KEY=

# Sanity public configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-13

# Server-only tokens — never prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Future form delivery
FORM_DELIVERY_API_KEY=
FORM_DELIVERY_DESTINATION=

# Future property/market data adapters
ADDRESS_LOOKUP_API_KEY=
RENTAL_COMPARABLES_API_KEY=

# Optional analytics; do not activate without the approved privacy/consent setup
NEXT_PUBLIC_ANALYTICS_ID=

